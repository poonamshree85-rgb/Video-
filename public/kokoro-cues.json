{
  "durationSeconds": 40.44,
  "durationInFrames": 1214,
  "beatTimings": {
    "b1": {
      "startSec": 0.15,
      "endSec": 2.967,
      "startFrame": 4,
      "endFrame": 89,
      "text": "In this town, your hair color decides your whole life."
    },
    "b2": {
      "startSec": 3.047,
      "endSec": 6.427,
      "startFrame": 91,
      "endFrame": 193,
      "text": "Black hair? You're a cop. Blonde? A teacher. Brown? You build houses."
    },
    "b3": {
      "startSec": 6.507,
      "endSec": 9.324,
      "startFrame": 195,
      "endFrame": 280,
      "text": "On day one, the school sorts every kid by hair."
    },
    "b4": {
      "startSec": 9.394,
      "endSec": 12.493,
      "startFrame": 282,
      "endFrame": 375,
      "text": "But nobody here had ever been born a ginger. Until me."
    },
    "b5": {
      "startSec": 12.593,
      "endSec": 15.973,
      "startFrame": 378,
      "endFrame": 479,
      "text": "No class would take me, so I sat alone in the hallway."
    },
    "b6": {
      "startSec": 16.043,
      "endSec": 18.578,
      "startFrame": 481,
      "endFrame": 557,
      "text": "The bully called me the glitch, and everyone laughed."
    },
    "b7": {
      "startSec": 18.658,
      "endSec": 20.912,
      "startFrame": 560,
      "endFrame": 627,
      "text": "Every morning, my mom dyed my hair brown."
    },
    "b8": {
      "startSec": 20.972,
      "endSec": 23.225,
      "startFrame": 629,
      "endFrame": 697,
      "text": "And every day, it washed out by lunch."
    },
    "b9": {
      "startSec": 23.315,
      "endSec": 26.132,
      "startFrame": 699,
      "endFrame": 784,
      "text": "Then the principal opened the oldest rule book in town."
    },
    "b10": {
      "startSec": 26.202,
      "endSec": 28.737,
      "startFrame": 786,
      "endFrame": 862,
      "text": "On the last page, in red ink, it said..."
    },
    "w1": {
      "startSec": 28.877,
      "endSec": 29.477,
      "startFrame": 866,
      "endFrame": 884,
      "text": "GINGER!"
    },
    "w2": {
      "startSec": 29.597,
      "endSec": 30.197,
      "startFrame": 888,
      "endFrame": 906,
      "text": "IS!"
    },
    "w3": {
      "startSec": 30.317,
      "endSec": 30.917,
      "startFrame": 910,
      "endFrame": 928,
      "text": "MAYOR!"
    },
    "b11": {
      "startSec": 31.097,
      "endSec": 34.196,
      "startFrame": 933,
      "endFrame": 1026,
      "text": "Now the bully sweeps the street in front of my house."
    },
    "b12": {
      "startSec": 34.266,
      "endSec": 36.519,
      "startFrame": 1028,
      "endFrame": 1096,
      "text": "And mom finally threw away the brown dye."
    },
    "b13": {
      "startSec": 36.639,
      "endSec": 39.738,
      "startFrame": 1099,
      "endFrame": 1192,
      "text": "But last night, my baby brother was born... with blue hair."
    }
  },
